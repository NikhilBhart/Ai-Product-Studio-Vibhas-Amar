# Shared
APP_ENV=local

# PostgreSQL
POSTGRES_DB=ai_product_studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://studio:change-me@localhost:5433/ai_product_studio

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ai_product_studio
SPRING_DATASOURCE_USERNAME=studio
SPRING_DATASOURCE_PASSWORD=change-me
AGENT_SERVICE_URL=http://localhost:8001

# LangGraph Agent LLM - mock mode has no API cost and requires no key
LLM_PROVIDER=mock
LLM_MODEL=demo-product-manager
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Gemini OpenAI-compatible example (confirm model availability):
# LLM_PROVIDER=gemini-compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=your-google-ai-studio-key

# Integrations (future phases; do not commit tokens)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
